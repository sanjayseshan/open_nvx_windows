+   unsigned swizzle_r:3;
+   unsigned swizzle_g:3;
+   unsigned swizzle_b:3;
+   unsigned swizzle_a:3;
+   struct pipe_resource *texture;
+   void *context;
+   union {
+      struct {
+         unsigned first_layer:16;
+         unsigned last_layer:16;
+         unsigned first_level:8;
