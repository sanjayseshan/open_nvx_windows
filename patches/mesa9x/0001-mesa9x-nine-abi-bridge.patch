+	              pPresentationParameters ? pPresentationParameters->MultiSampleType : 0,
+	              pPresentationParameters ? pPresentationParameters->SwapEffect : 0,
+	              pPresentationParameters ? pPresentationParameters->Windowed : 0,
+	              pPresentationParameters ? pPresentationParameters->EnableAutoDepthStencil : 0,
+	              pPresentationParameters ? pPresentationParameters->AutoDepthStencilFormat : 0);
