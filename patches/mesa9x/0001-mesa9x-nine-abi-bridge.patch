+static struct pipe_context *bridge_context_create(struct pipe_screen *screen, void *priv, unsigned flags) {
+    mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "bridge_context_create: flags=0x%x priv=%p calling M27 offset %d", flags, priv, M27_OFFSET_CONTEXT_CREATE);
+    void *m27_ctx = M27_CALL(g_m27_screen, M27_OFFSET_CONTEXT_CREATE, void*(*)(void*,void*,unsigned), priv, flags);
+    mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "bridge_context_create returned m27_ctx=%p", m27_ctx);
+    if (!m27_ctx) return NULL;
+
+    struct bridge_pipe_context *bctx = calloc(1, sizeof(struct bridge_pipe_context));
+    if (!bctx) return NULL;
+
+    bctx->m27_ctx = m27_ctx;
+    bctx->screen23 = screen;
+
+    struct pipe_context *ctx23 = &bctx->base23;
+    ctx23->screen = screen;
+    char *m27_base = (char *)m27_ctx;
+    ctx23->priv = *(void**)(m27_base + 4);
+    ctx23->draw = *(void**)(m27_base + 8);
+    ctx23->vbuf = *(void**)(m27_base + 12);
+    ctx23->stream_uploader = u_upload_create_default(ctx23);
+    ctx23->const_uploader = u_upload_create(ctx23, 1024 * 1024,
+                                            PIPE_BIND_CONSTANT_BUFFER,
+                                            PIPE_USAGE_STREAM, 0);
+    /* debug callback in m27 is at offset 24 (size 12) */
+    memcpy(&ctx23->debug, m27_base + 24, sizeof(ctx23->debug));
+
+    bridge_setup_context_vtable(ctx23, m27_base);
+
+    mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "bridge_context_create: wrapped ctx23=%p backing m27_ctx=%p", ctx23, m27_ctx);
+    return ctx23;
+}
+
+
+static bool bridge_is_format_supported(struct pipe_screen *screen, enum pipe_format format, enum pipe_texture_target target, unsigned sample_count, unsigned storage_sample_count, unsigned bindings) {
+    int m27_fmt = translate_m23_to_m27_format((int)format);
+    bool res = M27_CALL(g_m27_screen, M27_OFFSET_IS_FORMAT_SUPPORTED, bool(*)(void*,int,int,unsigned,unsigned,unsigned), m27_fmt, (int)target, sample_count, storage_sample_count, bindings);
+    mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "is_fmt_sup: m23_fmt=%d -> m27_fmt=%d target=%d samples=%u bind=0x%x -> %d",
+                  (int)format, m27_fmt, (int)target, sample_count, bindings, (int)res);
+    return res;
+}
+
+struct m27_pipe_resource {
+   char __cl_space[64];
+   uint32_t width0;
+   uint32_t height0;
+   uint16_t depth0;
+   uint16_t array_size;
+   enum pipe_format format:16;
+   enum pipe_texture_target target:8;
+   uint8_t last_level;
+   uint8_t nr_samples;
+   uint8_t nr_storage_samples;
+   uint8_t nr_sparse_levels;
+   unsigned compression_rate:4;
+   unsigned usage:4;
+   uint32_t bind;
+   uint32_t flags;
+   void *clientptr_heap;
+   struct pipe_resource *next;
+   struct pipe_screen *screen;
+};
+
+static struct pipe_resource *bridge_resource_create(struct pipe_screen *screen, const struct pipe_resource *templ) {
+    struct m27_pipe_resource m27_templ;
+    memset(&m27_templ, 0, sizeof(m27_templ));
+    m27_templ.width0 = templ->width0;
+    m27_templ.height0 = templ->height0;
+    m27_templ.depth0 = templ->depth0;
+    m27_templ.array_size = templ->array_size;
+    m27_templ.format = (enum pipe_format)translate_m23_to_m27_format((int)templ->format);
+    m27_templ.target = templ->target;
+    m27_templ.last_level = templ->last_level;
+    m27_templ.nr_samples = templ->nr_samples;
+    m27_templ.nr_storage_samples = templ->nr_storage_samples;
+    m27_templ.nr_sparse_levels = templ->nr_sparse_levels;
+    m27_templ.usage = templ->usage;
+    m27_templ.bind = templ->bind;
+    m27_templ.flags = templ->flags;
+
+    mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "res_create: m23_fmt=%d -> m27_fmt=%d %ux%u target=%d bind=0x%x",
+                  (int)templ->format, (int)m27_templ.format, templ->width0, templ->height0, templ->target, templ->bind);
+    struct pipe_resource *res = M27_CALL(g_m27_screen, M27_OFFSET_RESOURCE_CREATE, struct pipe_resource*(*)(void*,const void*), &m27_templ);
+    if (res) {
+        mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "res_create success: res=%p", res);
+        res->format = templ->format; // keep m23 format in returned resource for frontend
+        *(void **)((char *)res + 92) = NULL; // M23 res->next
+        *(void **)((char *)res + 96) = screen; // M23 res->screen
+    } else {
+        mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "res_create FAILED!");
+    }
+    return res;
+}
+
+static void bridge_resource_destroy(struct pipe_screen *screen, struct pipe_resource *res) {
+    M27_CALL(g_m27_screen, M27_OFFSET_RESOURCE_DESTROY, void(*)(void*,void*), res);
+}
+
+static void bridge_fence_reference(struct pipe_screen *screen, struct pipe_fence_handle **ptr, struct pipe_fence_handle *fence) {
+    M27_CALL(g_m27_screen, M27_OFFSET_FENCE_REFERENCE, void(*)(void*,struct pipe_fence_handle**,struct pipe_fence_handle*), ptr, fence);
+}
+
+static bool bridge_fence_finish(struct pipe_screen *screen, struct pipe_context *ctx, struct pipe_fence_handle *fence, uint64_t timeout) {
+    void *m27_ctx = ctx ? M27_GET_CTX(ctx) : NULL;
+    return M27_CALL(g_m27_screen, M27_OFFSET_FENCE_FINISH, bool(*)(void*,void*,struct pipe_fence_handle*,uint64_t), m27_ctx, fence, timeout);
+}
+
+static struct pipe_screen *create_m23_bridged_screen(void *m27) {
+    g_m27_screen = m27;
+    struct pipe_screen *ps23 = calloc(1, sizeof(struct pipe_screen));
+    ps23->refcnt = 1;
+    ps23->get_name = bridge_get_name;
+    ps23->get_vendor = bridge_get_vendor;
+    ps23->get_device_vendor = bridge_get_device_vendor;
+    ps23->get_param = bridge_get_param;
+    ps23->get_paramf = bridge_get_paramf;
+    ps23->get_shader_param = bridge_get_shader_param;
+    ps23->context_create = bridge_context_create;
+    ps23->is_format_supported = bridge_is_format_supported;
+    ps23->resource_create = bridge_resource_create;
+    ps23->resource_destroy = bridge_resource_destroy;
+    ps23->fence_reference = bridge_fence_reference;
+    ps23->fence_finish = bridge_fence_finish;
+    return ps23;
+}
+
+HRESULT WINAPI NineNine_new(INineNine **ppOut)
+{
+	HRESULT hr;
+	HWND hDesktop = GetDesktopWindow();
+	HDC hdc = GetDC(hDesktop);
+	struct pipe_screen *screen = NULL;
+	
+	if(!MesaScreenCreateProc)
+	{
+		return D3DERR_INVALIDCALL;
+	}
+	
+	mesa99_dbg("Creating screen");
+	
+	if(last_screen != NULL)
+	{
+		screen = last_screen;
+	}
+	else
+	{
+		void *raw_m27 = NULL;
+		if(!MesaScreenCreateProc(hdc, &raw_m27, MESA_SCREEN_USE_TGSI))
+		{
+			mesa99_dbg("MesaScreenCreate failed");
+			return D3DERR_INVALIDCALL;
+		}
+		mesa99_dbg("Bridging raw screen %p to Mesa 23.1.x ABI", raw_m27);
+		screen = create_m23_bridged_screen(raw_m27);
+		last_screen = screen; // Cache the BRIDGED screen!
+	}
+	
+  mesa99_dbg("bridged screen: %p", screen);
+	INineNine *res = calloc(1, sizeof(INineNine));
+	res->base.lpVtbl = &NineNineEx_vtable;
+	res->screen = screen;
+
+	hr = d3dadapter9_context_create(&res->ctx, screen);
+	if (SUCCEEDED(hr))
+	{
+		hr = NineAdapter9_new(&res->ctx, (struct NineAdapter9 **)&res->adapter9);
+		if (FAILED(hr))
+		{
+            /// @todo NineAdapter9_new calls this as ctx->base.destroy,
+            //       and will not call if memory allocation fails.
+            // wddm_destroy(&pCtx->base);
+      mesa99_dbg("d3dadapter9_context_create FAILED");
+    	return D3DERR_INVALIDCALL;
+		}
+	}
+	
+	*ppOut = res;
+	
+	return hr;
+}
