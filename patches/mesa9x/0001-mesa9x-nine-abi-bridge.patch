+static void bridge_ctx_clear_depth_stencil(struct pipe_context *ctx,
+                                           struct pipe_surface *dst23,
+                                           unsigned clear_flags,
+                                           double depth,
+                                           unsigned stencil,
+                                           unsigned dstx, unsigned dsty,
+                                           unsigned width, unsigned height,
+                                           bool render_condition_enabled) {
+    mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "clear_ds: %ux%u flags=0x%x at (%u,%u)", width, height, clear_flags, dstx, dsty);
+    void *m27 = M27_GET_CTX(ctx);
+    void (*m27_clear)(void *, unsigned, uint32_t, uint8_t, const void *, const union pipe_color_union *, double, unsigned) =
+        M27_FPTR(ctx, 404, void(*)(void*, unsigned, uint32_t, uint8_t, const void*, const union pipe_color_union*, double, unsigned));
+    if (!m27_clear) return;
+
+    unsigned bufs = 0;
+    if (clear_flags & PIPE_CLEAR_DEPTH) bufs |= PIPE_CLEAR_DEPTH;
+    if (clear_flags & PIPE_CLEAR_STENCIL) bufs |= PIPE_CLEAR_STENCIL;
+    uint32_t scissor[4] = { dstx, dsty, dstx + width, dsty + height };
+    m27_clear(m27, bufs, 0, 0, scissor, NULL, depth, stencil);
