+static inline int translate_m23_to_m27_format(int fmt23) {
+    if (fmt23 >= 0 && fmt23 < (int)(sizeof(m23_to_m27_pipe_format_lut)/sizeof(m23_to_m27_pipe_format_lut[0]))) {
