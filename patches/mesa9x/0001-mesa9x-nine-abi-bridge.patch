+/* Cache of current vertex buffer strides per buffer index (0..31) for Mesa 27 ABI translation */
+static uint32_t g_vtxbuf_strides[32] = {0};
+static void *g_bound_vertex_elements = NULL;
+static void *g_fallback_vertex_elements = NULL;
+
+/* Mesa 27 Gallium struct pipe_vertex_buffer: stride moved to pipe_vertex_element */
+struct m27_pipe_vertex_buffer {
+   bool is_user_buffer;
+   unsigned buffer_offset;
+   union {
+      struct pipe_resource *resource;
+      const void *user;
+   } buffer;
+};
+
+/* Mesa 27 Gallium struct pipe_vertex_element: added src_stride at offset 4 */
+struct m27_pipe_vertex_element {
+   uint16_t src_offset;
+   uint8_t vertex_buffer_index:7;
+   bool dual_slot:1;
+   uint8_t src_format;
+   uint32_t src_stride;
+   unsigned instance_divisor;
+};
+
+static void bridge_ctx_set_vertex_buffers(struct pipe_context *ctx,
+                                          unsigned start_slot,
+                                          unsigned num_buffers,
+                                          unsigned unbind_num_trailing_slots,
+                                          bool take_ownership,
+                                          const struct pipe_vertex_buffer *buffers) {
+    void *m27 = M27_GET_CTX(ctx);
+    void (*m27_set_vb)(void *, unsigned, const struct m27_pipe_vertex_buffer *) =
+        M27_FPTR(ctx, 368, void(*)(void *, unsigned, const struct m27_pipe_vertex_buffer *));
+
+    if (!m27_set_vb) return;
+
+    if (buffers && num_buffers > 0) {
+        for (unsigned i = 0; i < num_buffers; i++) {
+            unsigned slot = start_slot + i;
+            if (slot < 32) {
+                g_vtxbuf_strides[slot] = buffers[i].stride;
+            }
+        }
+    } else {
+        for (unsigned i = 0; i < unbind_num_trailing_slots; i++) {
+            unsigned slot = start_slot + i;
+            if (slot < 32) {
+                g_vtxbuf_strides[slot] = 0;
+            }
+        }
+    }
+
+    struct m27_pipe_vertex_buffer vb27[32];
+    unsigned count = start_slot + num_buffers;
+    if (count > 32) count = 32;
+
+    /* Nine (and CSO) may pass (start_slot, num_buffers). For Mesa 27's set_vertex_buffers(ctx, count, vb),
+     * we translate into an array starting at slot 0. If start_slot == 0, direct translation: */
+    if (start_slot == 0) {
+        if (!buffers || num_buffers == 0) {
+            m27_set_vb(m27, 0, NULL);
+            return;
+        }
+        for (unsigned i = 0; i < num_buffers && i < 32; i++) {
+            vb27[i].is_user_buffer = buffers[i].is_user_buffer;
+            vb27[i].buffer_offset = buffers[i].buffer_offset;
+            vb27[i].buffer.resource = buffers[i].buffer.resource;
+        }
+        m27_set_vb(m27, num_buffers, vb27);
+    } else {
+        /* start_slot > 0: set up slots up to start_slot + num_buffers */
+        memset(vb27, 0, sizeof(vb27));
+        for (unsigned i = 0; i < num_buffers && (start_slot + i) < 32; i++) {
+            unsigned idx = start_slot + i;
+            vb27[idx].is_user_buffer = buffers[i].is_user_buffer;
+            vb27[idx].buffer_offset = buffers[i].buffer_offset;
+            vb27[idx].buffer.resource = buffers[i].buffer.resource;
+        }
+        m27_set_vb(m27, count, vb27);
+    }
+}
+
+static void bridge_ctx_set_scissor_states(struct pipe_context *ctx,
+                                          unsigned start_slot,
+                                          unsigned num_scissors,
+                                          const struct pipe_scissor_state *scissors) {
+    void *m27 = M27_GET_CTX(ctx);
+    void (*m27_set_scissors)(void *, unsigned, unsigned, const void *) =
+        M27_FPTR(ctx, 328, void(*)(void *, unsigned, unsigned, const void *));
+
+    if (!m27_set_scissors) return;
+
+    if (!scissors) {
+        m27_set_scissors(m27, start_slot, num_scissors, NULL);
+        return;
+    }
+
+    uint32_t m27_scissors[16 * 4];
+    for (unsigned i = 0; i < num_scissors && i < 16; i++) {
+        m27_scissors[i * 4 + 0] = scissors[i].minx;
+        m27_scissors[i * 4 + 1] = scissors[i].miny;
+        m27_scissors[i * 4 + 2] = scissors[i].maxx;
+        m27_scissors[i * 4 + 3] = scissors[i].maxy;
+    }
+    m27_set_scissors(m27, start_slot, num_scissors, m27_scissors);
+}
