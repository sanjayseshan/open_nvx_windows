+static void bridge_ctx_surface_destroy(struct pipe_context *ctx, struct pipe_surface *surf) {
+    mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "bridge_ctx_surface_destroy: surf=%p", surf);
+    if (surf) {
+        free(surf);
+    }
+}
