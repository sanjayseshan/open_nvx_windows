+void mesa99_printf(const char *file, const char *fn, int line, const char *fmt, ...)
+{
+	static int s_debug_enabled = 0;
+	if (!s_debug_enabled) return;
+  va_list args;
+	FILE *fa;
+	
+	fa = fopen("C:\\mesa99.log", "ab");
+	if(fa)
+	{
+		fprintf(fa, "%s:%s:%d: ", file, fn, line);
+		va_start(args, fmt);
+	  vfprintf(fa, fmt, args);
+	  va_end(args);
+	  fputs("\r\n", fa);
+		fclose(fa);
+	}
+	char buf[1024];
+	int n = snprintf(buf, sizeof(buf), "[MESA99] %s:%d: ", fn, line);
+	va_start(args, fmt);
+	int n2 = vsnprintf(buf + n, sizeof(buf) - n - 2, fmt, args);
+	va_end(args);
+	if (n2 > 0) n += n2;
+	buf[n++] = '\r'; buf[n++] = '\n'; buf[n] = 0;
+	OutputDebugStringA(buf);
+	HANDLE hCom = CreateFileA("\\\\.\\COM1", GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+	if (hCom != INVALID_HANDLE_VALUE) {
+		DWORD written = 0;
+		WriteFile(hCom, buf, n, &written, NULL);
+		CloseHandle(hCom);
+	}
+}
