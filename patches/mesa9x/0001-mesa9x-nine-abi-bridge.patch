+static void bridge_fill_m27_surface(struct m27_pipe_surface *dst27, const struct pipe_surface *src23) {
+    memset(dst27, 0, sizeof(*dst27));
+    if (!src23 || !src23->texture) return;
+    dst27->reference.count = 1;
+    dst27->format = (enum pipe_format)translate_m23_to_m27_format((int)src23->format);
+    dst27->nr_samples = src23->nr_samples;
+    dst27->first_layer = src23->u.tex.first_layer;
+    dst27->last_layer = src23->u.tex.last_layer;
+    dst27->level = src23->u.tex.level;
+    dst27->texture = src23->texture;
+}
