+static struct pipe_surface *bridge_ctx_create_surface(struct pipe_context *ctx,
+                                                      struct pipe_resource *resource,
+                                                      const struct pipe_surface *templat) {
+    mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "bridge_ctx_create_surface: res=%p fmt=%d level=%u layer=%u",
+                  resource, templat ? templat->format : 0, templat ? templat->u.tex.level : 0, templat ? templat->u.tex.first_layer : 0);
+    struct pipe_surface *surf = calloc(1, sizeof(struct pipe_surface));
+    if (!surf) return NULL;
+    surf->reference.count = 1;
+    surf->texture = resource;
+    surf->context = ctx;
+    if (templat) {
+        surf->format = templat->format;
+        surf->nr_samples = templat->nr_samples;
+        surf->u = templat->u;
+    } else if (resource) {
+        surf->format = resource->format;
+        surf->nr_samples = resource->nr_samples;
+    }
+    if (resource) {
+        surf->width = u_minify(resource->width0, surf->u.tex.level);
+        surf->height = u_minify(resource->height0, surf->u.tex.level);
+    }
+    return surf;
+}
