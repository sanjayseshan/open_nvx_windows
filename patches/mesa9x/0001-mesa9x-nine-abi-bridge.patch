+    templ27.is_tex2d_from_buf = templ23->is_tex2d_from_buf;
+    templ27.texture = texture;
+    templ27.context = m27;
+    templ27.u.tex.first_layer = templ23->u.tex.first_layer;
+    templ27.u.tex.last_layer = templ23->u.tex.last_layer;
+    templ27.u.tex.first_level = templ23->u.tex.first_level;
+    templ27.u.tex.last_level = templ23->u.tex.last_level;
+
+    struct m27_pipe_sampler_view *m27_view = m27_create_sv(m27, texture, &templ27);
+    mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "create_sampler_view: tex=%p m23_fmt=%d -> m27_fmt=%d res=%p",
+                  texture, (int)templ23->format, (int)templ27.format, m27_view);
+    if (!m27_view) return NULL;
