+
+struct m27_pipe_surface {
+   struct pipe_reference reference;
+   enum pipe_format format:16;
+   unsigned nr_samples:16;
+   unsigned first_layer:16;
+   unsigned last_layer:16;
+   unsigned level;
+   struct pipe_resource *texture;
+};
+
+struct m27_pipe_framebuffer_state {
+   uint32_t width, height;
+   uint16_t layers;
+   uint8_t samples;
+   uint8_t nr_cbufs;
+   bool pls_enabled:1;
+   bool downscale_cbufs:1;
+   uint8_t _pad:6;
+   uint8_t viewmask;
