+HRESULT WINAPI NineNine_GetAdapterDisplayModeEx(INineNine *This, UINT Adapter, D3DDISPLAYMODEEX *pMode, D3DDISPLAYROTATION *pRotation)
+{
+	if(Adapter >= NineNine_GetAdapterCount(This))
