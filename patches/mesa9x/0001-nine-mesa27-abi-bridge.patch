+    struct bridge_sampler_view_wrapper *wrap = (struct bridge_sampler_view_wrapper *)view23;
+    mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "sampler_view_destroy: view23=%p m27_view=%p", view23, wrap->m27_view);
