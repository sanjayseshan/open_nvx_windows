+static ULONG WINAPI DRIPresentGroup_Release(ID3DPresentGroupM99 *This)
+{
+	ULONG cnt = InterlockedDecrement(&This->refcount);
+	if(cnt == 0)
+	{
+		free(This);
+	}
+	
+	return cnt;
+}
