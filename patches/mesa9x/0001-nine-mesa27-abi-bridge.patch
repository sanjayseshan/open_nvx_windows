+struct m27_pipe_draw_info {
+   uint8_t mode;
+   uint16_t index_size;
+   bool primitive_restart:1;
+   bool has_user_indices:1;
+   bool index_bounds_valid:1;
+   bool increment_draw_id:1;
+   bool index_bias_varies:1;
+   bool was_line_loop:1;
