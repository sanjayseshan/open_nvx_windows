+/* Mesa 27 moves strides into vertex elements. Keep the Mesa 23 state
+ * per context and rebuild the native vertex elements when a stride changes. */
+struct bridge_vertex_elements {
+    unsigned count;
+    struct pipe_vertex_element elements[PIPE_MAX_ATTRIBS];
+    void *native;
+};
+
+/* Mesa 27 Gallium struct pipe_vertex_buffer: stride moved to pipe_vertex_element */
+struct m27_pipe_vertex_buffer {
+   bool is_user_buffer;
+   unsigned buffer_offset;
+   union {
+      struct pipe_resource *resource;
+      const void *user;
+   } buffer;
+};
+
+/* Mesa 27 Gallium struct pipe_vertex_element: added src_stride at offset 4 */
+struct m27_pipe_vertex_element {
+   uint16_t src_offset;
+   uint8_t vertex_buffer_index:7;
+   bool dual_slot:1;
+   uint8_t src_format;
+   uint32_t src_stride;
+   unsigned instance_divisor;
+};
+
+static void bridge_ctx_set_vertex_buffers(struct pipe_context *ctx,
+                                          unsigned start_slot,
+                                          unsigned num_buffers,
+                                          unsigned unbind_num_trailing_slots,
+                                          bool take_ownership,
+                                          const struct pipe_vertex_buffer *buffers) {
+    void *m27 = M27_GET_CTX(ctx);
+    void (*m27_set_vb)(void *, unsigned, const struct m27_pipe_vertex_buffer *) =
+        M27_FPTR(ctx, 368, void(*)(void *, unsigned, const struct m27_pipe_vertex_buffer *));
+
+    if (!m27_set_vb) return;
+
+    struct bridge_pipe_context *bctx = (struct bridge_pipe_context *)ctx;
+    if (start_slot + num_buffers > PIPE_MAX_ATTRIBS ||
+        start_slot + num_buffers + unbind_num_trailing_slots > PIPE_MAX_ATTRIBS)
+        return;
+    util_set_vertex_buffers_count(bctx->vertex_buffers, &bctx->num_vertex_buffers,
+                                  buffers, start_slot, num_buffers,
+                                  unbind_num_trailing_slots, take_ownership);
+    bctx->vertex_elements_dirty = true;
+    struct m27_pipe_vertex_buffer native[PIPE_MAX_ATTRIBS] = {{0}};
+    for (unsigned i = 0; i < bctx->num_vertex_buffers; ++i) {
+        const struct pipe_vertex_buffer *v = &bctx->vertex_buffers[i];
+        native[i].is_user_buffer = v->is_user_buffer;
+        native[i].buffer_offset = v->buffer_offset;
+        native[i].buffer.resource = v->is_user_buffer ? (void *)v->buffer.user : M27_RESOURCE(v->buffer.resource);
+    }
+    m27_set_vb(m27, bctx->num_vertex_buffers, native);
+}
+
+static void bridge_validate_vertex_elements(struct pipe_context *ctx)
+{
+    struct bridge_pipe_context *bctx = (struct bridge_pipe_context *)ctx;
+    struct bridge_vertex_elements *ve = bctx->vertex_elements;
+    if (!ve || !bctx->vertex_elements_dirty) return;
+    void *(*create)(void *, unsigned, const struct m27_pipe_vertex_element *) =
+        M27_FPTR(ctx, 248, void *(*)(void *, unsigned, const struct m27_pipe_vertex_element *));
+    void (*bind)(void *, void *) = M27_FPTR(ctx, 252, void (*)(void *, void *));
+    void (*destroy)(void *, void *) = M27_FPTR(ctx, 256, void (*)(void *, void *));
+    struct m27_pipe_vertex_element native[PIPE_MAX_ATTRIBS] = {{0}};
+    for (unsigned i = 0; i < ve->count; ++i) {
+        const struct pipe_vertex_element *e = &ve->elements[i];
+        native[i].src_offset = e->src_offset;
+        native[i].vertex_buffer_index = e->vertex_buffer_index;
+        native[i].dual_slot = e->dual_slot;
+        native[i].src_format = translate_m23_to_m27_format(e->src_format);
+        native[i].src_stride = bctx->vertex_buffers[e->vertex_buffer_index].stride;
+        native[i].instance_divisor = e->instance_divisor;
+    }
+    void *replacement = create(M27_GET_CTX(ctx), ve->count, native);
+    bind(M27_GET_CTX(ctx), replacement);
+    if (ve->native) destroy(M27_GET_CTX(ctx), ve->native);
+    ve->native = replacement;
+    bctx->vertex_elements_dirty = false;
+}
