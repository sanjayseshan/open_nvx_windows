+HRESULT WINAPI NineNine_EnumAdapterModes(INineNine *This, UINT Adapter, D3DFORMAT Format, UINT Mode, D3DDISPLAYMODE *pMode)
+{
+	if(Adapter >= NineNine_GetAdapterCount(This))
+	{
