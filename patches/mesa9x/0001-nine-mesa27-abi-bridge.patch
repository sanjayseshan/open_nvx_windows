+    bool vertex_elements_dirty;
+};
+
+#define M27_GET_CTX(ctx23) (((struct bridge_pipe_context *)(ctx23))->m27_ctx)
+#define M27_FPTR(ctx23, off, type) ((type)(*(void **)((char *)M27_GET_CTX(ctx23) + (off))))
+
+static void bridge_ctx_destroy(struct pipe_context *ctx) {
+    void *m27 = M27_GET_CTX(ctx);
+    mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "bridge_ctx_destroy: ctx=%p m27=%p", ctx, m27);
+    struct bridge_pipe_context *bctx = (struct bridge_pipe_context *)ctx;
+    util_set_vertex_buffers_count(bctx->vertex_buffers, &bctx->num_vertex_buffers,
+                                  NULL, 0, 0, PIPE_MAX_ATTRIBS, false);
+    if (ctx->stream_uploader) {
+        u_upload_destroy(ctx->stream_uploader);
+        ctx->stream_uploader = NULL;
+    }
+    if (ctx->const_uploader) {
+        u_upload_destroy(ctx->const_uploader);
+        ctx->const_uploader = NULL;
+    }
+    void (*m27_destroy)(void *) = *(void **)((char *)m27 + 40);
+    if (m27_destroy) {
+        m27_destroy(m27);
+    }
+    free(ctx);
+}
