+static void bridge_fill_m27_surface(struct m27_pipe_surface *dst27, const struct pipe_surface *src23) {
+    memset(dst27, 0, sizeof(*dst27));
+    if (!src23 || !src23->texture) return;
+    dst27->reference.count = 1;
+    dst27->format = (enum pipe_format)translate_m23_to_m27_format((int)src23->format);
+    dst27->nr_samples = src23->nr_samples;
+    dst27->first_layer = src23->u.tex.first_layer;
+    dst27->last_layer = src23->u.tex.last_layer;
+    dst27->level = src23->u.tex.level;
+    dst27->texture = M27_RESOURCE(src23->texture);
+}
+
+static void bridge_ctx_set_framebuffer_state(struct pipe_context *ctx, const struct pipe_framebuffer_state *fb23) {
+    void *m27 = M27_GET_CTX(ctx);
+    void (*m27_set_fb)(void *, const struct m27_pipe_framebuffer_state *) = M27_FPTR(ctx, 316, void(*)(void*, const struct m27_pipe_framebuffer_state*));
+
+    if (!m27_set_fb) return;
+    if (!fb23) {
+        m27_set_fb(m27, NULL);
+        return;
+    }
+
+    struct m27_pipe_framebuffer_state fb27;
+    memset(&fb27, 0, sizeof(fb27));
+    fb27.width = fb23->width;
+    fb27.height = fb23->height;
+    fb27.layers = fb23->layers;
+    fb27.samples = fb23->samples;
+    fb27.nr_cbufs = fb23->nr_cbufs;
+    fb27.resolve = M27_RESOURCE(fb23->resolve);
+
+    for (unsigned i = 0; i < fb23->nr_cbufs && i < PIPE_MAX_COLOR_BUFS; i++) {
+        if (fb23->cbufs[i]) {
+            bridge_fill_m27_surface(&fb27.cbufs[i], fb23->cbufs[i]);
+        }
+    }
+    if (fb23->zsbuf) {
+        bridge_fill_m27_surface(&fb27.zsbuf, fb23->zsbuf);
+    }
+
+    m27_set_fb(m27, &fb27);
+}
