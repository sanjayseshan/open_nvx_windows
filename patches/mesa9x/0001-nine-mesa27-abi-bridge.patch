+/* Lifecycle/failure diagnostics only; never called for normal frame traffic. */
+void mesa99_report(const char *message)
+{
+    OutputDebugStringA(message);
+    HANDLE serial = CreateFileA("\\\\.\\COM1", GENERIC_WRITE,
+                               FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                               OPEN_EXISTING, 0, NULL);
+    if (serial != INVALID_HANDLE_VALUE) {
+        DWORD written;
+        WriteFile(serial, message, (DWORD)strlen(message), &written, NULL);
+        CloseHandle(serial);
+    }
+}
