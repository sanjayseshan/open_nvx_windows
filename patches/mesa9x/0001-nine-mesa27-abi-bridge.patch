+                                           double depth,
+                                           unsigned stencil,
+                                           unsigned dstx, unsigned dsty,
+                                           unsigned width, unsigned height,
+                                           bool render_condition_enabled) {
+    void (*fn)(void *, struct m27_pipe_surface *, unsigned, double, unsigned, unsigned, unsigned, unsigned, unsigned, bool) =
+        M27_FPTR(ctx, 412, void (*)(void *, struct m27_pipe_surface *, unsigned, double, unsigned, unsigned, unsigned, unsigned, unsigned, bool));
+    struct m27_pipe_surface surface;
+    bridge_fill_m27_surface(&surface, dst23);
+    if (fn) fn(M27_GET_CTX(ctx), &surface, clear_flags, depth, stencil, dstx, dsty, width, height, render_condition_enabled);
