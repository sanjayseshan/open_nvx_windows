+static void bridge_ctx_clear_render_target(struct pipe_context *ctx,
+                                           struct pipe_surface *dst23,
+                                           const union pipe_color_union *color,
+                                           unsigned dstx, unsigned dsty,
+                                           unsigned width, unsigned height,
+                                           bool render_condition_enabled) {
+    void (*fn)(void *, struct m27_pipe_surface *, const union pipe_color_union *, unsigned, unsigned, unsigned, unsigned, bool) =
+        M27_FPTR(ctx, 408, void (*)(void *, struct m27_pipe_surface *, const union pipe_color_union *, unsigned, unsigned, unsigned, unsigned, bool));
+    struct m27_pipe_surface surface;
+    bridge_fill_m27_surface(&surface, dst23);
+    if (fn) fn(M27_GET_CTX(ctx), &surface, color, dstx, dsty, width, height, render_condition_enabled);
+}
