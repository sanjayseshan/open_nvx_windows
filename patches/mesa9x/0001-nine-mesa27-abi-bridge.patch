+static void bridge_ctx_clear(struct pipe_context *ctx,
+                             unsigned buffers,
+                             const struct pipe_scissor_state *scissor_state,
+                             const union pipe_color_union *color,
+                             double depth,
+                             unsigned stencil) {
+    mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "clear: bufs=0x%x depth=%f stencil=%u", buffers, (float)depth, stencil);
+    void *m27 = M27_GET_CTX(ctx);
+    void (*m27_clear)(void *, unsigned, uint32_t, uint8_t, const void *, const union pipe_color_union *, double, unsigned) =
+        M27_FPTR(ctx, 404, void(*)(void*, unsigned, uint32_t, uint8_t, const void*, const union pipe_color_union*, double, unsigned));
+
+    if (!m27_clear) return;
+
+    uint32_t m27_scissor[4];
+    const void *p_scissor = NULL;
+    if (scissor_state) {
+        m27_scissor[0] = scissor_state->minx;
+        m27_scissor[1] = scissor_state->miny;
+        m27_scissor[2] = scissor_state->maxx;
+        m27_scissor[3] = scissor_state->maxy;
+        p_scissor = m27_scissor;
+    }
+    m27_clear(m27, buffers, ~0u, 0xff, p_scissor, color, depth, stencil);
+}
