+/* --- M27 GALLIUM BRIDGE CONTEXT & SURFACE WRAPPERS --- */
+
+/* Never expose a backend Gallium object through a different Gallium ABI. */
+struct bridge_resource {
+    struct pipe_resource base23;
+    struct pipe_resource *native;
+};
+
+void *bridge_unwrap_m27_resource(void *res)
+{
+    return res ? ((struct bridge_resource *)res)->native : NULL;
+}
+#define M27_RESOURCE(res) ((struct pipe_resource *)bridge_unwrap_m27_resource(res))
+
+struct m27_box { int32_t x, width, y, height; int16_t z, depth; };
+static struct m27_box bridge_box(const struct pipe_box *b)
+{
+    return (struct m27_box){b->x, b->width, b->y, b->height, b->z, b->depth};
+}
+struct m27_transfer {
+    struct pipe_resource *resource;
+    unsigned usage:24, level:8;
+    struct m27_box box;
+    unsigned stride;
+    uintptr_t layer_stride;
+    unsigned offset;
+};
+struct bridge_transfer {
+    struct pipe_transfer base23;
+    struct m27_transfer *native;
+};
