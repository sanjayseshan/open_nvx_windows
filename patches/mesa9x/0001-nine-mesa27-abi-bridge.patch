+/* Mesa 27 doubled the stream-output array and added compile diagnostics.
+ * Passing the smaller Mesa 23 state makes the backend read beyond it. */
+struct m27_shader_state {
+    enum pipe_shader_ir type;
+    const struct tgsi_token *tokens;
+    union { void *nir; } ir;
+    struct {
+        unsigned num_outputs;
+        uint16_t stride[PIPE_MAX_SO_BUFFERS];
+        struct pipe_stream_output output[128];
+    } stream_output;
+    bool report_compile_error;
+    char *error_message;
+};
+static void bridge_shader_state(struct m27_shader_state *dst,
+                                const struct pipe_shader_state *src)
+{
+    memset(dst, 0, sizeof(*dst));
+    dst->type = src->type;
+    dst->tokens = src->tokens;
+    dst->ir.nir = src->ir.nir;
+    dst->stream_output.num_outputs = src->stream_output.num_outputs;
+    memcpy(dst->stream_output.stride, src->stream_output.stride, sizeof(src->stream_output.stride));
+    memcpy(dst->stream_output.output, src->stream_output.output, sizeof(src->stream_output.output));
+}
