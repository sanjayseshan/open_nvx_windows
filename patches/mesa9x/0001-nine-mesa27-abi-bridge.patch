+        
+	if(IsEqualGUID(&IID_ID3DPresentGroup, riid) || IsEqualGUID(&IID_IUnknown, riid))
+	{
+		*ppvObject = This;
+		DRIPresentGroup_AddRef(This);
+		return S_OK;
+	}
+
+	*ppvObject = NULL;
+
+	return E_NOINTERFACE;
