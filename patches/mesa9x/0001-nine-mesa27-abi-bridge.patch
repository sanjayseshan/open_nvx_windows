+static void bridge_ctx_draw_vbo(struct pipe_context *ctx,
+                                const struct pipe_draw_info *info,
+                                unsigned drawid_offset,
+                                const struct pipe_draw_indirect_info *indirect,
+                                const struct pipe_draw_start_count_bias *draws,
+                                unsigned num_draws) {
+    void *m27 = M27_GET_CTX(ctx);
+    void (*m27_draw_vbo)(void *, const struct m27_pipe_draw_info *, unsigned, const struct pipe_draw_indirect_info *, const struct pipe_draw_start_count_bias *, unsigned) =
+        M27_FPTR(ctx, 44, void(*)(void *, const struct m27_pipe_draw_info *, unsigned, const struct pipe_draw_indirect_info *, const struct pipe_draw_start_count_bias *, unsigned));
+    if (!m27_draw_vbo || !info) return;
+    bridge_validate_vertex_elements(ctx);
+    struct m27_pipe_draw_info info27;
+    memset(&info27, 0, sizeof(info27));
+    if (info) {
+        info27.mode = info->mode;
+        info27.index_size = info->index_size;
+        info27.primitive_restart = info->primitive_restart;
+        info27.has_user_indices = info->has_user_indices;
+        info27.index_bounds_valid = info->index_bounds_valid;
+        info27.increment_draw_id = info->increment_draw_id;
+        info27.index_bias_varies = info->index_bias_varies;
+        info27.was_line_loop = info->was_line_loop;
+        info27.start_instance = info->start_instance;
+        info27.instance_count = info->instance_count;
+        info27.restart_index = info->restart_index;
+        info27.index.resource = info->has_user_indices ? (void *)info->index.user : (info->index_size ? M27_RESOURCE(info->index.resource) : NULL);
+        info27.min_index = info->min_index;
+        info27.max_index = info->max_index;
+    }
+    struct pipe_draw_indirect_info native_indirect;
+    if (indirect) {
+        native_indirect = *indirect;
+        native_indirect.buffer = M27_RESOURCE(indirect->buffer);
+        native_indirect.indirect_draw_count = M27_RESOURCE(indirect->indirect_draw_count);
+    }
+    m27_draw_vbo(m27, &info27, drawid_offset, indirect ? &native_indirect : NULL, draws, num_draws);
+    if (info->take_index_buffer_ownership && info->index_size && !info->has_user_indices) {
+        struct pipe_resource *owned = info->index.resource;
+        pipe_resource_reference(&owned, NULL);
+    }
+}
