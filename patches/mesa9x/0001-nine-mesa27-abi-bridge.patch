+
+    mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "res_create: m23_fmt=%d -> m27_fmt=%d %ux%u target=%d bind=0x%x",
+                  (int)templ->format, (int)m27_templ.format, templ->width0, templ->height0, templ->target, templ->bind);
+    struct pipe_resource *res = M27_CALL(g_m27_screen, M27_OFFSET_RESOURCE_CREATE, struct pipe_resource*(*)(void*,const void*), &m27_templ);
+    if (!res) return NULL;
+    struct bridge_resource *wrap = CALLOC_STRUCT_CL(bridge_resource);
+    if (!wrap) {
+        M27_CALL(g_m27_screen, M27_OFFSET_RESOURCE_DESTROY, void(*)(void*,void*), res);
+        return NULL;
+    }
+    wrap->base23 = *templ;
+    wrap->base23.reference.count = 1;
+    wrap->base23.next = NULL;
+    wrap->base23.screen = screen;
+    wrap->native = res;
+    return &wrap->base23;
+}
+
+static void bridge_resource_destroy(struct pipe_screen *screen, struct pipe_resource *res) {
+    struct bridge_resource *wrap = (struct bridge_resource *)res;
+    /* Backend bindings/views may still reference the resource. Drop only
+     * the reference owned by this frontend wrapper. */
+    struct pipe_reference *ref = (struct pipe_reference *)wrap->native;
+    if (InterlockedDecrement((LONG *)&ref->count) == 0)
+        M27_CALL(g_m27_screen, M27_OFFSET_RESOURCE_DESTROY, void(*)(void*,void*), wrap->native);
+    FREE_CL(wrap);
+}
+
+static void bridge_fence_reference(struct pipe_screen *screen, struct pipe_fence_handle **ptr, struct pipe_fence_handle *fence) {
+    M27_CALL(g_m27_screen, M27_OFFSET_FENCE_REFERENCE, void(*)(void*,struct pipe_fence_handle**,struct pipe_fence_handle*), ptr, fence);
+}
+
+static bool bridge_fence_finish(struct pipe_screen *screen, struct pipe_context *ctx, struct pipe_fence_handle *fence, uint64_t timeout) {
+    void *m27_ctx = ctx ? M27_GET_CTX(ctx) : NULL;
+    return M27_CALL(g_m27_screen, M27_OFFSET_FENCE_FINISH, bool(*)(void*,void*,struct pipe_fence_handle*,uint64_t), m27_ctx, fence, timeout);
+}
+
+static struct pipe_screen *create_m23_bridged_screen(void *m27) {
+    const char *tag = "[MESA99_BRIDGE] revision=340 resource_wrappers=1 shader_state_translation=1 box_translation=1\r\n";
+    OutputDebugStringA(tag);
+    HANDLE serial = CreateFileA("\\\\.\\COM1", GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                                NULL, OPEN_EXISTING, 0, NULL);
+    if (serial != INVALID_HANDLE_VALUE) {
+        DWORD written;
+        WriteFile(serial, tag, (DWORD)strlen(tag), &written, NULL);
+        CloseHandle(serial);
+    }
+
+    g_m27_screen = m27;
+    struct pipe_screen *ps23 = calloc(1, sizeof(struct pipe_screen));
+    ps23->refcnt = 1;
+    ps23->get_name = bridge_get_name;
+    ps23->get_vendor = bridge_get_vendor;
+    ps23->get_device_vendor = bridge_get_device_vendor;
+    ps23->get_param = bridge_get_param;
+    ps23->get_paramf = bridge_get_paramf;
+    ps23->get_shader_param = bridge_get_shader_param;
+    ps23->context_create = bridge_context_create;
+    ps23->is_format_supported = bridge_is_format_supported;
+    ps23->resource_create = bridge_resource_create;
+    ps23->resource_destroy = bridge_resource_destroy;
+    ps23->fence_reference = bridge_fence_reference;
+    ps23->fence_finish = bridge_fence_finish;
+    return ps23;
+}
+
+HRESULT WINAPI NineNine_new(INineNine **ppOut)
+{
+	HRESULT hr;
+	HWND hDesktop = GetDesktopWindow();
+	HDC hdc = GetDC(hDesktop);
+	struct pipe_screen *screen = NULL;
+	
+	if(!MesaScreenCreateProc)
+	{
+		return D3DERR_INVALIDCALL;
+	}
+	
+	mesa99_dbg("Creating screen");
+	
+	if(last_screen != NULL)
+	{
+		screen = last_screen;
+	}
+	else
+	{
+		void *raw_m27 = NULL;
+		if(!MesaScreenCreateProc(hdc, &raw_m27, MESA_SCREEN_USE_TGSI))
+		{
+			mesa99_dbg("MesaScreenCreate failed");
+			return D3DERR_INVALIDCALL;
+		}
+		mesa99_dbg("Bridging raw screen %p to Mesa 23.1.x ABI", raw_m27);
+		screen = create_m23_bridged_screen(raw_m27);
+		last_screen = screen; // Cache the BRIDGED screen!
+	}
+	
+  mesa99_dbg("bridged screen: %p", screen);
+	INineNine *res = calloc(1, sizeof(INineNine));
+	res->base.lpVtbl = &NineNineEx_vtable;
+	res->screen = screen;
+
+	hr = d3dadapter9_context_create(&res->ctx, screen);
+	if (SUCCEEDED(hr))
+	{
+		hr = NineAdapter9_new(&res->ctx, (struct NineAdapter9 **)&res->adapter9);
+		if (FAILED(hr))
+		{
+            /// @todo NineAdapter9_new calls this as ctx->base.destroy,
+            //       and will not call if memory allocation fails.
+            // wddm_destroy(&pCtx->base);
+      mesa99_dbg("d3dadapter9_context_create FAILED");
+    	return D3DERR_INVALIDCALL;
+		}
+	}
+	
+	*ppOut = res;
+	
+	return hr;
+}
