+static struct pipe_sampler_view *bridge_ctx_create_sampler_view(struct pipe_context *ctx,
+                                                               struct pipe_resource *texture,
+                                                               const struct pipe_sampler_view *templ23) {
+    void *m27 = M27_GET_CTX(ctx);
+    struct m27_pipe_sampler_view *(*m27_create_sv)(void *, struct pipe_resource *, const struct m27_pipe_sampler_view *) =
+        M27_FPTR(ctx, 444, struct m27_pipe_sampler_view *(*)(void *, struct pipe_resource *, const struct m27_pipe_sampler_view *));
+
+    if (!m27_create_sv) return NULL;
+
+    struct m27_pipe_sampler_view templ27;
+    memset(&templ27, 0, sizeof(templ27));
+    templ27.format = (enum pipe_format)translate_m23_to_m27_format((int)templ23->format);
+    templ27.target = templ23->target;
+    templ27.swizzle_r = templ23->swizzle_r;
+    templ27.swizzle_g = templ23->swizzle_g;
+    templ27.swizzle_b = templ23->swizzle_b;
+    templ27.swizzle_a = templ23->swizzle_a;
+    templ27.is_tex2d_from_buf = templ23->is_tex2d_from_buf;
+    templ27.texture = M27_RESOURCE(texture);
+    templ27.context = m27;
+    templ27.u.tex.first_layer = templ23->u.tex.first_layer;
+    templ27.u.tex.last_layer = templ23->u.tex.last_layer;
+    templ27.u.tex.first_level = templ23->u.tex.first_level;
+    templ27.u.tex.last_level = templ23->u.tex.last_level;
+
+    struct m27_pipe_sampler_view *m27_view = m27_create_sv(m27, M27_RESOURCE(texture), &templ27);
+    mesa99_printf(__FILE__, __FUNCTION__, __LINE__, "create_sampler_view: tex=%p m23_fmt=%d -> m27_fmt=%d res=%p",
+                  texture, (int)templ23->format, (int)templ27.format, m27_view);
+    if (!m27_view) return NULL;
+
+    struct bridge_sampler_view_wrapper *wrap = CALLOC_STRUCT_CL(bridge_sampler_view_wrapper);
+    if (!wrap) return NULL;
+
+    wrap->base23.reference.count = 1;
+    wrap->base23.format = templ23->format;
+    wrap->base23.target = templ23->target;
+    wrap->base23.swizzle_r = templ23->swizzle_r;
+    wrap->base23.swizzle_g = templ23->swizzle_g;
+    wrap->base23.swizzle_b = templ23->swizzle_b;
+    wrap->base23.swizzle_a = templ23->swizzle_a;
+    wrap->base23.is_tex2d_from_buf = templ23->is_tex2d_from_buf;
+    pipe_resource_reference(&wrap->base23.texture, texture);
+    wrap->base23.context = ctx;
+    wrap->base23.u = templ23->u;
+    wrap->m27_view = m27_view;
+
+    return &wrap->base23;
+}
