+static void *bridge_ctx_create_fs_state(struct pipe_context *ctx, const struct pipe_shader_state *state) {
+    void *m27 = M27_GET_CTX(ctx);
+    void *(*fn)(void *, const struct m27_shader_state *) = M27_FPTR(ctx, 188, void *(*)(void *, const struct m27_shader_state *));
+    struct m27_shader_state native;
+    bridge_shader_state(&native, state);
+    const struct tgsi_token *lowered = NULL;
+    if (state->type == PIPE_SHADER_IR_TGSI) {
+        struct tgsi_lowering_config config = {0};
+        struct tgsi_shader_info info;
+        config.lower_LIT = config.lower_EXP = config.lower_LOG = config.lower_DST = 1;
+        lowered = tgsi_transform_lowering(&config, state->tokens, &info);
+        if (lowered) native.tokens = lowered;
+    }
+    void *result = fn ? fn(m27, &native) : NULL;
+    if (lowered) tgsi_free_tokens(lowered);
+    return result;
+}
