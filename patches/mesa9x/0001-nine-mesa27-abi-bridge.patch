+static void bridge_ctx_blit(struct pipe_context *ctx, const struct pipe_blit_info *info) {
+    void *m27 = M27_GET_CTX(ctx);
+    void (*fn)(void *, const struct m27_blit_info *) = M27_FPTR(ctx, 400, void (*)(void *, const struct m27_blit_info *));
+    struct m27_blit_info b = {0};
+    b.src.resource = M27_RESOURCE(info->src.resource);
+    b.dst.resource = M27_RESOURCE(info->dst.resource);
+    b.src.level = info->src.level; b.dst.level = info->dst.level;
+    b.src.box = bridge_box(&info->src.box); b.dst.box = bridge_box(&info->dst.box);
+    b.src.format = translate_m23_to_m27_format(info->src.format);
+    b.dst.format = translate_m23_to_m27_format(info->dst.format);
+    b.mask = info->mask; b.filter = info->filter; b.dst_sample = info->dst_sample;
+    b.sample0_only = info->sample0_only; b.scissor_enable = info->scissor_enable;
+    b.scissor = (struct m27_scissor){info->scissor.minx, info->scissor.miny, info->scissor.maxx, info->scissor.maxy};
+    /* Mesa 23 has no blit swizzle fields. */
+    b.window_rectangle_include = info->window_rectangle_include;
+    b.num_window_rectangles = info->num_window_rectangles;
+    for (unsigned i = 0; i < b.num_window_rectangles && i < PIPE_MAX_WINDOW_RECTANGLES; ++i) {
+        const struct pipe_scissor_state *r = &info->window_rectangles[i];
