+static void *bridge_ctx_map(struct pipe_context *ctx, struct pipe_resource *resource, unsigned level, unsigned usage, const struct pipe_box *box, struct pipe_transfer **out_transfer, unsigned map_offset) {
+    void *m27 = M27_GET_CTX(ctx);
+    void *(*fn)(void *, struct pipe_resource *, unsigned, unsigned, const struct m27_box *, struct m27_transfer **) =
+        M27_FPTR(ctx, map_offset, void *(*)(void *, struct pipe_resource *, unsigned, unsigned, const struct m27_box *, struct m27_transfer **));
+    *out_transfer = NULL;
+    if (!fn) { mesa99_report("[NINE_MAP_FAIL] callback NULL\r\n"); return NULL; }
+    struct bridge_transfer *t = calloc(1, sizeof(*t));
+    if (!t) return NULL;
+    struct m27_box b = bridge_box(box);
+    void *data = fn(m27, M27_RESOURCE(resource), level, usage, &b, &t->native);
+    if (!data || !t->native) {
+        char diagnostic[512];
+        snprintf(diagnostic, sizeof(diagnostic),
+                 "[NINE_MAP_FAIL] offset=%u ctx=%p native_ctx=%p res=%p native_res=%p format=%u level=%u usage=%x box=%d,%d,%d %dx%dx%d data=%p transfer=%p\r\n",
+                 map_offset, ctx, m27, resource, M27_RESOURCE(resource),
+                 resource->format, level, usage, b.x, b.y, b.z,
+                 b.width, b.height, b.depth, data, t->native);
+        mesa99_report(diagnostic);
+        free(t); return NULL;
+    }
+    t->base23.resource = resource;
+    t->base23.usage = usage; t->base23.level = level; t->base23.box = *box;
+    t->base23.stride = t->native->stride;
+    t->base23.layer_stride = t->native->layer_stride;
+    t->base23.offset = t->native->offset;
+    *out_transfer = &t->base23;
+    return data;
+}
