@ECHO OFF
REM DOS-compatible package staging only. Device Manager must bind the INF.
IF NOT EXIST NVX.INF GOTO NO_PACKAGE
IF NOT EXIST NVX.DRV GOTO NO_PACKAGE
IF NOT EXIST NVX.VXD GOTO NO_PACKAGE
IF NOT EXIST GSPGA104.BIN GOTO NO_PACKAGE

IF NOT EXIST C:\DRIVERS\NUL MD C:\DRIVERS
IF NOT EXIST C:\DRIVERS\NVX\NUL MD C:\DRIVERS\NVX

COPY /B /Y NVX.INF C:\DRIVERS\NVX\NVX.INF
IF ERRORLEVEL 1 GOTO COPY_FAILED
COPY /B /Y NVX.DRV C:\DRIVERS\NVX\NVX.DRV
IF ERRORLEVEL 1 GOTO COPY_FAILED
COPY /B /Y NVX.VXD C:\DRIVERS\NVX\NVX.VXD
IF ERRORLEVEL 1 GOTO COPY_FAILED
COPY /B /Y GSPGA104.BIN C:\DRIVERS\NVX\GSPGA104.BIN
IF ERRORLEVEL 1 GOTO COPY_FAILED

IF EXIST NVX2.DRV COPY /B /Y NVX2.DRV C:\DRIVERS\NVX\NVX2.DRV
IF EXIST ATTACH_SEC.EXE COPY /B /Y ATTACH_SEC.EXE C:\DRIVERS\NVX\ATTACH_SEC.EXE
IF EXIST NVXOGL32.DLL COPY /B /Y NVXOGL32.DLL C:\DRIVERS\NVX\NVXOGL32.DLL
IF EXIST NINE\NUL XCOPY NINE C:\DRIVERS\NVX\NINE /E /I /Y
IF EXIST LEGACY\NUL XCOPY LEGACY C:\DRIVERS\NVX\LEGACY /E /I /Y

ECHO.
ECHO NVX package staged in C:\DRIVERS\NVX.
ECHO Start Windows with WIN, then use Device Manager and Have Disk:
ECHO C:\DRIVERS\NVX\NVX.INF
ECHO This DOS script only copies files; it does not bind or install the driver.
GOTO END

:NO_PACKAGE
ECHO ERROR: Run this script from the extracted NVX package directory.
ECHO Required files: NVX.INF, NVX.DRV, NVX.VXD, GSPGA104.BIN.
GOTO END

:COPY_FAILED
ECHO ERROR: A package file could not be copied. Check free disk space and retry.

:END
