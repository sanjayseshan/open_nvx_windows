+static struct pipe_screen *nvx_present_screen;
+static struct pipe_resource *nvx_present_stage;
+static unsigned nvx_present_width;
+static unsigned nvx_present_height;
+static enum pipe_format nvx_present_format;
+
+static bool
+nvx_wgl_present_gpu(struct pipe_screen *screen, struct pipe_context *ctx,
+                    struct pipe_resource *res, HDC hDC)
+{
+   struct pipe_resource templ;
+   struct pipe_box box;
+   struct winsys_handle handle;
+   bool result = false;
+   uint64_t blit_start, flush_start;
+
+   if (!screen || !ctx || !res || !hDC || !screen->resource_create ||
+       !screen->resource_get_handle || !ctx->resource_copy_region ||
+       !ctx->flush || res->target != PIPE_TEXTURE_2D ||
+       res->format != PIPE_FORMAT_B8G8R8A8_UNORM || res->nr_samples > 1 ||
+       !res->width0 || !res->height0 || res->width0 > 4096 ||
+       res->height0 > 4096)
+      return false;
+
+   if (InterlockedCompareExchange(&nvx_present_busy, 1, 0) != 0)
+      return false;
+
+   if (nvx_present_stage &&
+       (nvx_present_screen != screen || nvx_present_width != res->width0 ||
+        nvx_present_height != res->height0 ||
+        nvx_present_format != res->format)) {
+      nvx_present_screen->resource_destroy(nvx_present_screen,
+                                           nvx_present_stage);
+      nvx_present_stage = NULL;
+      nvx_present_screen = NULL;
+   }
+   if (!nvx_present_stage) {
+      memset(&templ, 0, sizeof(templ));
+      templ.target = PIPE_TEXTURE_2D;
+      templ.format = res->format;
+      templ.width0 = res->width0;
+      templ.height0 = res->height0;
+      templ.depth0 = 1;
+      templ.array_size = 1;
+      templ.last_level = 0;
+      templ.nr_samples = 1;
+      templ.nr_storage_samples = 1;
+      templ.usage = PIPE_USAGE_STAGING;
+      templ.bind = PIPE_BIND_SHARED | PIPE_BIND_LINEAR;
+      nvx_present_stage = screen->resource_create(screen, &templ);
+      if (!nvx_present_stage) {
+         nvx_present_trace("GPU present: staging resource allocation failed");
+         goto done;
+      }
+      nvx_present_screen = screen;
+      nvx_present_width = res->width0;
+      nvx_present_height = res->height0;
+      nvx_present_format = res->format;
+   }
+
+   memset(&box, 0, sizeof(box));
+   box.width = res->width0;
+   box.height = res->height0;
+   box.depth = 1;
+   blit_start = nvx_wgl_present_timer();
+   ctx->resource_copy_region(ctx, nvx_present_stage, 0, 0, 0, 0,
+                             res, 0, &box);
+   flush_start = nvx_wgl_present_timer();
+   ctx->flush(ctx, NULL, 0);
+   nvx_wgl_trace_stage_timing(nvx_wgl_present_elapsed_us(blit_start),
+                              nvx_wgl_present_elapsed_us(flush_start));
+
+   memset(&handle, 0, sizeof(handle));
+   handle.type = WINSYS_HANDLE_TYPE_SHARED;
+   if (screen->resource_get_handle(screen, ctx, nvx_present_stage,
+                                   &handle, 0) &&
+       handle.handle && handle.stride &&
+       nvx_wgl_wait_gpu_buffer((uint32_t)(uintptr_t)handle.handle))
+      result = nvx_wgl_present_gpu_copy(hDC,
+                                        (uint32_t)(uintptr_t)handle.handle,
+                                        handle.stride,
+                                        res->width0, res->height0) != 0;
+   else
+      nvx_present_trace("GPU present: staging export or NVX fence wait failed");
+
+done:
+   if (!result)
+      nvx_present_trace("GPU present: attempt fell back to Mesa flush/readback");
+   InterlockedExchange(&nvx_present_busy, 0);
+   return result;
+}
