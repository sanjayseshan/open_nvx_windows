+BOOL WINAPI MesaScreenCreate(HDC hdc, struct pipe_screen **pScreen, DWORD flags);
+BOOL WINAPI MesaPresent(struct pipe_screen *screen, struct pipe_context *ctx,
+                        struct pipe_resource *res, HDC dc,
+                        const RECT *pSrcRect, const RECT *pDstRect);
+BOOL WINAPI MesaDimensions(struct pipe_screen *screen, struct pipe_context *ctx,
+                           struct pipe_resource *res,
+                           int *pWidth, int *pHeight, int *pBpp, int *pPitch);
+
+BOOL WINAPI
+MesaScreenCreate(HDC hdc, struct pipe_screen **pScreen, DWORD flags)
+{
+   (void)flags;
+   if (hdc)
+      nvx_wgl_set_hdc(hdc);
+   struct pipe_screen *screen = stw_winsys.create_screen(hdc);
+   if (!screen)
+      return FALSE;
+   if (pScreen)
+      *pScreen = screen;
+   return TRUE;
+}
+
+BOOL WINAPI
+MesaPresent(struct pipe_screen *screen, struct pipe_context *ctx,
+            struct pipe_resource *res, HDC dc,
+            const RECT *pSrcRect, const RECT *pDstRect)
+{
+   (void)pSrcRect;
+   (void)pDstRect;
+   if (!screen || !res || !dc)
+      return FALSE;
+   stw_winsys.present(screen, ctx, res, dc);
+   return TRUE;
+}
+
+BOOL WINAPI
+MesaDimensions(struct pipe_screen *screen, struct pipe_context *ctx,
+               struct pipe_resource *res,
+               int *pWidth, int *pHeight, int *pBpp, int *pPitch)
+{
+   (void)screen;
+   (void)ctx;
+   if (!res)
+      return FALSE;
+   if (pWidth)
+      *pWidth = res->width0;
+   if (pHeight)
+      *pHeight = res->height0;
+   if (pBpp)
+      *pBpp = 32;
+   if (pPitch)
+      *pPitch = res->width0 * 4;
+   return TRUE;
+}
