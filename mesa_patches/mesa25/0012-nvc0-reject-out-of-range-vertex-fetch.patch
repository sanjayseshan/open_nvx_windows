+            } else if (info->index_size) {
+               const int64_t indexed_first = (int64_t)info->min_index +
+                                             draws[i].index_bias;
+               const int64_t indexed_last = (int64_t)info->max_index +
+                                            draws[i].index_bias;
+               index_values_valid = indexed_first >= 0 &&
+                                    indexed_last >= indexed_first;
+               first_index = index_values_valid ?
+                             (uint64_t)indexed_first : 0;
+               last_index = index_values_valid ?
+                            (uint64_t)indexed_last : 0;
+            } else {
+               first_index = draws[i].start;
+               last_index = (uint64_t)draws[i].start + draws[i].count - 1U;
+            }
+
+            {
+               const uint64_t offset = (uint64_t)vb->buffer_offset +
+                                       ve->pipe.src_offset;
+               const uint64_t resource_bytes =
+                  vb->buffer.resource->width0;
+               bool range_valid = index_values_valid &&
+                  first_index <= last_index &&
+                  offset <= resource_bytes &&
+                  elem_size <= resource_bytes - offset &&
+                  (!ve->pipe.src_stride || last_index <=
+                   (resource_bytes - offset - elem_size) /
+                      ve->pipe.src_stride);
+
+               /* Nine forwards D3D9's MinVertexIndex/NumVertices hint. Some
+                * apps overstate it; before dropping the draw, derive the real
