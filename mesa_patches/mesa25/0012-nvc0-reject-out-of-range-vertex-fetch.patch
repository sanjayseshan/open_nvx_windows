+/* A few D3D9 applications provide a conservative MinVertexIndex/NumVertices
+ * range that is larger than the actual indices in the draw.  If that hint
+ * alone would make us drop a draw, inspect the bounded index slice and use
+ * its real range for the resource safety check.  This is a slow exceptional
+ * path; ordinary draws never map their index buffers here.
+ */
+static bool
+nvx_nvc0_scan_index_range(struct pipe_context *pipe,
+                          const struct pipe_draw_info *info,
+                          const struct pipe_draw_start_count_bias *draw,
+                          int64_t *first, int64_t *last)
+{
+   struct pipe_transfer *transfer = NULL;
+   const uint8_t *indices;
+   uint64_t byte_offset, byte_count;
+   uint32_t min_index = ~0U, max_index = 0;
+   uint32_t restart_index;
+   bool found = false;
+
+   if (!info->index_size || !draw->count || draw->count > (1U << 20) ||
+       (info->index_size != 1 && info->index_size != 2 &&
+        info->index_size != 4))
+      return false;
+
+   byte_offset = (uint64_t)draw->start * info->index_size;
+   byte_count = (uint64_t)draw->count * info->index_size;
+   if (byte_offset > UINT_MAX || byte_count > UINT_MAX)
+      return false;
+
+   if (info->has_user_indices) {
+      if (!info->index.user)
+         return false;
+      indices = (const uint8_t *)info->index.user + byte_offset;
+   } else {
+      if (!info->index.resource ||
+          byte_offset > info->index.resource->width0 ||
+          byte_count > info->index.resource->width0 - byte_offset)
+         return false;
+      indices = pipe_buffer_map_range(pipe, info->index.resource,
+                                      (unsigned)byte_offset,
+                                      (unsigned)byte_count, PIPE_MAP_READ,
+                                      &transfer);
+      if (!indices)
+         return false;
+   }
+
+   restart_index = info->restart_index;
+   if (info->index_size == 1)
+      restart_index &= 0xffU;
+   else if (info->index_size == 2)
+      restart_index &= 0xffffU;
+
+   for (unsigned i = 0; i < draw->count; ++i) {
+      uint32_t index = 0;
+      memcpy(&index, indices + (uint64_t)i * info->index_size,
+             info->index_size);
+      if (info->primitive_restart && index == restart_index)
+         continue;
+      min_index = MIN2(min_index, index);
+      max_index = MAX2(max_index, index);
+      found = true;
+   }
+
+   if (transfer)
+      pipe_buffer_unmap(pipe, transfer);
+   if (!found)
+      return false;
+
+   *first = (int64_t)min_index + draw->index_bias;
+   *last = (int64_t)max_index + draw->index_bias;
+   return *first >= 0 && *last >= *first;
+}
