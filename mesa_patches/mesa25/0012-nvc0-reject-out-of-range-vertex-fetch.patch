+                        pipe, info, &draws[i], &actual_first_index,
+                        &actual_last_index);
+                     actual_index_range_checked = true;
+                  }
+                  if (actual_index_range_valid) {
+                     first_index = (uint64_t)actual_first_index;
+                     last_index = (uint64_t)actual_last_index;
+                     index_values_valid = true;
+                     range_valid = offset <= resource_bytes &&
+                        elem_size <= resource_bytes - offset &&
+                        (!ve->pipe.src_stride || last_index <=
+                         (resource_bytes - offset - elem_size) /
+                            ve->pipe.src_stride);
+#if defined(NVX_XP_WIN32_SHIMS)
+                     if (range_valid)
+                        NvxWglRecordNouveauPushbufItem(33U, e,
+                           (unsigned int)actual_first_index,
+                           (unsigned int)actual_last_index,
+                           info->min_index, info->max_index,
+                           info->index_size, draws[i].start);
+#endif
+                  }
+               }
+
+               if (!range_valid) {
+                  vertex_range_valid = false;
+#if defined(NVX_XP_WIN32_SHIMS)
+                  NvxWglRecordNouveauPushbufItem(30U, b, i,
+                     (unsigned int)last_index, ve->pipe.src_stride,
+                     (unsigned int)offset, (unsigned int)resource_bytes,
+                     elem_size);
+                  /* Capture the original D3D/Gallium range and binding so a
+                   * bad range hint can be separated from a stale/sliced VB.
+                   */
+                  NvxWglRecordNouveauPushbufItem(31U, e,
+                     draws[i].start, draws[i].count,
+                     info->min_index, info->max_index,
+                     (unsigned int)draws[i].index_bias, info->index_size);
+                  NvxWglRecordNouveauPushbufItem(32U, e,
+                     vb->buffer_offset, ve->pipe.src_offset,
+                     ve->pipe.src_stride, (unsigned int)resource_bytes,
+                     b, ve->pipe.instance_divisor);
+                  NvxWglRecordNouveauPushbufItem(33U, e,
+                     actual_index_range_checked,
+                     actual_index_range_valid,
+                     (unsigned int)actual_first_index,
+                     (unsigned int)actual_last_index,
+                     info->index_size, draws[i].start);
+#endif
+                  break;
+               }
+            }
+         }
+      }
+
+      if (vertex_range_valid &&
+          (indirect || (draws[i].count && info->instance_count)))
          nvc0_draw_single_vbo(pipe, info, drawid, indirect, &draws[i]);
       if (info->increment_draw_id)
          drawid++;
