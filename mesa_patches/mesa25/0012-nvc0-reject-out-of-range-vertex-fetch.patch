                          void *hwcso)
@@ -1067,6 +1150,13 @@ nvc0_draw_vbo(struct pipe_context *pipe, const struct pipe_draw_info *info,
 
    unsigned drawid = drawid_offset;
 
+   /* Reject invalid draws before vertex fetch can escape a Gallium resource.
+    * Nouveau suballocates resources from larger GART slabs, so an invalid
+    * fetch can read a neighboring resource before it reaches the slab edge.
+    */
+   const bool indexed_bounds_known =
