    simple_mtx_lock(&nvc0->screen->state_lock);
 
@@ -1160,7 +1250,127 @@ nvc0_draw_vbo(struct pipe_context *pipe, const struct pipe_draw_info *info,
    nvc0_state_validate_3d(nvc0, ~0);
 
    for (unsigned i = 0; i < num_draws; i++) {
-      if (indirect || (draws[i].count && info->instance_count))
+      bool vertex_range_valid = true;
+      bool actual_index_range_checked = false;
+      bool actual_index_range_valid = false;
+      int64_t actual_first_index = 0, actual_last_index = 0;
+
+      if (!indirect && indexed_bounds_known && draws[i].count &&
+          info->instance_count && nvc0->vertex) {
+         for (unsigned e = 0; e < nvc0->vertex->num_elements; e++) {
+            const struct nvc0_vertex_element *ve = &nvc0->vertex->element[e];
+            const unsigned b = ve->pipe.vertex_buffer_index;
+            const struct pipe_vertex_buffer *vb = &nvc0->vtxbuf[b];
+            const unsigned elem_size =
+               util_format_get_blocksize(ve->pipe.src_format);
+            uint64_t first_index, last_index;
+            bool index_values_valid = true;
+
+            if (!elem_size || !vb->buffer.resource ||
+                (nvc0->vbo_user & (1U << b)) ||
+                (nvc0->constant_vbos & (1U << b)))
+               continue;
+
+            if (ve->pipe.instance_divisor) {
+               first_index = (uint64_t)info->start_instance /
