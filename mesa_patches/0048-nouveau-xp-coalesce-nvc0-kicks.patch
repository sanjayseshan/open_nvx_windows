@@ -1166,7 +1166,15 @@ nvc0_draw_vbo(struct pipe_context *pipe, const struct pipe_draw_info *info,
          drawid++;
    }
 
+#if defined(NVX_XP_WIN32_SHIMS)
+   /* Validate and retain this draw's BO references before the context bins
+    * are reset below. Defer the escape until the shared push stream reaches
