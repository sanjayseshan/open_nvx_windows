+/* XP's validated miniport batch has finite reference, relocation, and dword
+ * limits. NVC0 may validate references after each draw and defer the kernel
+ * kick until this helper reports that the accumulated batch is near a limit. */
+bool nouveau_pushbuf_xp_batch_limit_reached(struct nouveau_pushbuf *push);
