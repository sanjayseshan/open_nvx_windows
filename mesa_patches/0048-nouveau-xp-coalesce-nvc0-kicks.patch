 {
    return pushbuf_refn(push, true, refs, nr);
 }
 
+bool nouveau_pushbuf_xp_batch_limit_reached(struct nouveau_pushbuf *push);
+
+/* Keep NVC0 draw references validated and retained in krec, but combine
+ * several small draw streams into one XP miniport submission. Stay below the
+ * NVX batch ABI limits with headroom for addresses discovered by the XP
+ * xf86drm translator. This is enabled only by the XP NVC0 caller. */
+bool
+nouveau_pushbuf_xp_batch_limit_reached(struct nouveau_pushbuf *push)
+{
+   struct nouveau_pushbuf_priv *nvpb;
+   struct nouveau_pushbuf_krec *krec;
+   uint64_t dwords = 0;
+   uint32_t i;
+   bool kick;
+
+   if (!push)
+      return true;
+   nvpb = nouveau_pushbuf(push);
+   krec = nvpb->krec;
+   for (i = 0; i < (uint32_t)krec->nr_push; i++) {
+      uint64_t bytes = krec->push[i].length &
+                       ~((uint64_t)NOUVEAU_GEM_PUSHBUF_NO_PREFETCH);
+      dwords += bytes / sizeof(uint32_t);
+   }
+   dwords += (uint64_t)(push->cur - nvpb->bgn);
+   kick = krec->nr_buffer >= 96 || krec->nr_reloc >= 192 ||
+          krec->nr_push >= 48 || dwords >= 12288 ||
+          (uint32_t)(push->end - push->cur) < 4096;
+#ifdef NVX_XP_WIN32_SHIMS
+   extern void NvxWglRecordNouveauCoalesceProfile(uint32_t deferred,
+      uint32_t buffers, uint32_t relocs, uint32_t pushes, uint32_t dwords);
+   NvxWglRecordNouveauCoalesceProfile(!kick, (uint32_t)krec->nr_buffer,
+      (uint32_t)krec->nr_reloc, (uint32_t)krec->nr_push,
+      dwords > UINT32_MAX ? UINT32_MAX : (uint32_t)dwords);
+#endif
+   return kick;
+}
