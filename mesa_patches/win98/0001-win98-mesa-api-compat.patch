@@ -127,6 +127,14 @@ util_set_thread_affinity(thrd_t thread,
    return pthread_setaffinity_np(thread, sizeof(cpuset), &cpuset) == 0;
 
 #elif defined(_WIN32) && !defined(HAVE_PTHREAD)
+#if defined(NVX_WIN98_DIOC)
+   /* Win9x exposes no supported per-thread affinity API. */
+   (void)thread;
+   (void)mask;
+   (void)old_mask;
+   (void)num_mask_bits;
+   return false;
+#else
    DWORD_PTR m = mask[0];
 
    if (sizeof(m) > 4 && num_mask_bits > 32)
@@ -146,6 +154,7 @@ util_set_thread_affinity(thrd_t thread,
    }
 
    return true;
+#endif
 #else
    return false;
 #endif
@@ -162,14 +171,19 @@ util_thread_get_time_nano(thrd_t thread)
    clock_gettime(cid, &ts);
    return (int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec;
 #elif defined(_WIN32)
+#if defined(NVX_WIN98_DIOC)
+   (void)thread;
+   return 0;
+#else
    union {
       FILETIME time;
       ULONGLONG value;
    } kernel_time, user_time;
    GetThreadTimes((HANDLE)thread.handle, NULL, NULL, &kernel_time.time, &user_time.time);
